# Copy to .env.local and fill in from the NEW Supabase project:
#   Project Settings > Data API  -> Project URL
#   Project Settings > API Keys  -> Publishable key (or the legacy "anon" key)
# The publishable key is meant for browsers; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxx

# Optional: the calendar-sync Edge Function's address, as shown in its
# Endpoint URL (…/functions/v1/<this>). Only needed if it is not "calendar-sync".
# VITE_CALENDAR_FUNCTION=calendar-sync
